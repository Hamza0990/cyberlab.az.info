# ============================================================
#  CYBERLAB — konfiqurasiya
#  Bu faylı ".env" adı ilə kopyalayıb doldurun.
# ============================================================

PORT=3000
NODE_ENV=production

# ---------- DOMEN / SEO ----------
# Saytın ƏSAS (kanonik) domeni — www-suz yazılır.
# Bütün digər variantlar (www, http) buraya 301 yönləndirilir.
CANONICAL_HOST=cyberlab.az.info

# Nginx / Cloudflare kimi reverse-proxy arxasındasınızsa true edin.
# (Real istifadəçi IP-sinin düzgün oxunması üçün VACİBDİR)
BEHIND_PROXY=true

# HTTPS-ə məcburi yönləndirmə.
# DİQQƏT: yalnız TLS sertifikatı qurulduqdan SONRA true edin!
FORCE_HTTPS=true

# Google Search Console doğrulama kodu.
# Google "google1a2b3c.html" verirsə, bura YALNIZ "1a2b3c" yazın.
GOOGLE_VERIFICATION=

# ---------- TƏHLÜKƏSİZLİK ----------
# Dəqiqədə IP başına icazə verilən maksimum sorğu
RATE_LIMIT_MAX=120

# Neçə şübhəli cəhddən sonra IP avtomatik bloklansın
STRIKE_LIMIT=3

# Avtomatik blokun müddəti (dəqiqə)
BLOCK_MINUTES=15

# Qəbul edilən maksimum URL uzunluğu (bayt)
MAX_URL_LENGTH=2048

# ---------- ADMİN PANEL (/admin) ----------
# ADMIN_PASSWORD boş qalsa panel TAMAMİLƏ deaktiv olur (404).
# Bu təhlükəsiz defaultdur — istifadə edəcəksinizsə güclü şifrə qoyun.
ADMIN_USER=admin
ADMIN_PASSWORD=
